# Rust
/target
**/*.rs.bk

# Node
**/node_modules
dist
.vite

# Generated wasm-pack output (rebuilt via `pnpm build:wasm`)
/packages/wasm-sim

# Large data artifacts — committed OUTPUTS only (see scripts/build_data.sh)
*.pmtiles
*.pbf
/data/raw

# Subtitle source art (~140 MB of raw covers). Kept LOCAL — too heavy for git history; only the
# processed transparent webp in packages/app/public/title/ are committed. Re-key + resize via
# `python3 scripts/build_subtitles.py`. (Move to git-LFS if these ever need versioning.)
/docs/subtitle/

# Playwright
playwright-report
test-results

# Misc
.DS_Store
*.log
.playwright-mcp/
# WSL alternate-data-stream stubs (downloaded-file security-zone metadata)
*:Zone.Identifier
